{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "HiiFest",
  "description": "Documentation for HiiFest — the all-in-one event management platform for organizers, attendees, vendors, and venue managers.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#5B21B6"
  },
  "favicon": "https://icons.duckduckgo.com/ip3/platform.hiifest.app.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Platform",
          "icon": "arrow-up-right",
          "href": "https://platform.hiifest.app"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "/support/contact"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction",
              "quickstart",
              "account-setup"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/workspace-types",
              "concepts/events",
              "concepts/ticketing",
              "concepts/team-members"
            ]
          }
        ]
      },
      {
        "tab": "Organizer Guide",
        "groups": [
          {
            "group": "Events",
            "pages": [
              "organizer/create-event",
              "organizer/ticket-tiers",
              "organizer/manage-attendees",
              "organizer/hybrid-events"
            ]
          },
          {
            "group": "Growth & Marketing",
            "pages": [
              "organizer/ai-features",
              "organizer/networking-hub",
              "organizer/referral-system",
              "organizer/custom-branding"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "organizer/analytics-dashboard",
              "organizer/advanced-analytics",
              "organizer/revenue-tracking"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "organizer/vendor-directory",
              "organizer/venue-mapping",
              "organizer/crm-integrations"
            ]
          }
        ]
      },
      {
        "tab": "Attendees & Vendors",
        "groups": [
          {
            "group": "Attendees",
            "pages": [
              "attendees/discover-events",
              "attendees/buy-tickets",
              "attendees/manage-tickets"
            ]
          },
          {
            "group": "Vendors & Venues",
            "pages": [
              "vendors/list-services",
              "vendors/manage-inquiries",
              "venues/list-venue",
              "venues/manage-bookings"
            ]
          }
        ]
      },
      {
        "tab": "Plans & Support",
        "groups": [
          {
            "group": "Pricing",
            "pages": [
              "plans/overview",
              "plans/compare",
              "plans/enterprise"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/submit-ticket",
              "support/faq",
              "support/contact"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Go to Platform",
      "href": "https://platform.hiifest.app"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hiifest",
      "linkedin": "https://linkedin.com/company/hiifest"
    }
  }
}
